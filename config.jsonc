{
  "hostname": "rethink.lan", // this can't be an IP address

  "homeassistant": {
    "mqtt_url": "mqtt://localhost:1883",
    "discovery_prefix": "homeassistant", // corresponds to discovery_prefix in homeassistant config
    "rethink_prefix": "rethink", // rethink topics will be prefixed with this
    "mqtt_user": "",
    "mqtt_pass": ""
  },

  // Rethink runs a builtin CA to sign its TLS endpoints' certificates. The same CA is used to sign
  // devices' certificates during provisioning.
  "ca_key_file": "ca.key", // will be created on first run if necessary
  "ca_cert_file": "ca.cert", // will be created on first run if necessary

  // During provisioning each device fetches a root certificate from rethink and keeps it to
  // validate its TLS connections. By default this is the builtin CA above, which is what a
  // typical configuration wants.
  //
  // If rethink sits behind a reverse HTTPS/TLS proxy, the certificate that proxy presents has
  // to chain to whatever was distributed here. Either derive the proxy's certificate from
  // rethink's CA and leave this commented out, or point this at the root certificate that
  // validates the proxy's. It changes nothing else: rethink's own listeners, and the
  // certificates it signs for devices, still come from the builtin CA.
  //
  // Devices cache what they were given, so changing this does not reach already-paired ones.
  // "custom_root_cert_file": "root.cert",

  // All ports can be specified in one of the following formats:
  // 0. No entry, or empty: ""https_port": {}
  //    the port will not be bound at all
  // 1. Simple port number: ""https_port": 443, equivalent to ""https_port": { "bind": 443 }
  //    binds to the catch-all 0.0.0.0 address on port 443
  // 2. Port with bind address: ""https_port": { "bind": 443, "address": "192.168.0.1" }
  //    binds specifically to 192.168.0.1:443
  //
  // Additionally, "https_port" and "mqtts_port" may contain a special "advertise" entry
  // which influences how rethink advertises these ports to connecting devices.
  // 1. No "advertise" field
  //    the device will receive a default url derived from `hostname` and `bind`, for example
  //    https://rethink.lan:443/
  // 2. A port number: "https_port": { "bind": 4443, "advertise": 443 }
  //    the URL will be derived from `hostname` and the specific port, distinct from the bind
  //    port -  useful for port-redirection scenarios
  // 3. A full URL: "https_port": { "bind": 443, "advertise": "https://other.machine:443" }
  //    the provided URL will be used verbatim
  //
  // Note some devices will not connect to a non-default advertised port, diverging from the
  // 443 & 8883 defaults may degrade compatibility.
  //
  // Examples:
  // Default configuration, bind to port 443 and expect devices to connect to it directly
  //  "https_port": 443
  // Bind to a unprivileged port, but redirect from 443 via iptables or similiar
  //  "https_port": { "bind": 4443, "advertise": 443 }
  // Running behind a reverse HTTPS proxy, don't bind HTTPS at all
  //  "https_port": { "advertise": 443 },
  //  "http_port": 80, // but bind unencrypted HTTP
  //
  "https_port": 443,
  "mqtts_port": 8883,

  // optional, useful for local testing, debugging or reverse-proxy scenarios
  // "http_port": 80,
  // "mqtt_port": 1884,

  // the defaults should not be changed unless you know what you're doing
  "thinq1_https_port": 46030,
  "thinq1_port": 47878,

  // specify anything you like. Removing this parameter disables the management interface
  "management_port": 44401,

  "bridge": {
    // The bridge must reach the real LG cloud, but the system resolver likely redirects the
    // ThinQ names back to rethink. If it does, list other servers here, tried in order: each
    // is a DNS-over-HTTPS URL or a plain DNS server address. DoH by IP address works even
    // where plain DNS on port 53 is intercepted. Empty or absent means the system resolver.
    "dns": ["https://1.1.1.1/dns-query", "https://8.8.8.8/dns-query"],
    "storage_path": "./state"
  },

  "log": ["status", "incoming", "HTTPS", "publish", "MGMT"]
}
